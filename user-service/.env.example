# Copy this file to .env and replace every <...> placeholder.
APP_ENV=local
APP_VERSION=dev
HTTP_ADDR=:8080
REQUEST_TIMEOUT=10s

# In Docker Compose, use the service name postgres as the host.
DATABASE_URL=postgres://<db_user>:<db_password>@postgres:5432/<db_name>?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=0

# Generate with: openssl genrsa -out ./keys/user-service-jwt.pem 3072
JWT_PRIVATE_KEY_PATH=./keys/user-service-jwt.pem
JWT_KEY_ID=local-2026-01
JWT_ISSUER=user-service
JWT_AUDIENCE=inference-platform
ACCESS_TOKEN_TTL=30m
PASSWORD_HASH_WORKERS=2

LOG_LEVEL=debug

OTEL_ENABLED=false
OTEL_SERVICE_NAME=user-service
OTEL_TRACE_SAMPLE_RATIO=1
# Required only when OTEL_ENABLED=true.
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
# OTEL_EXPORTER_OTLP_INSECURE=true
