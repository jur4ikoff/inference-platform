# Конфигурация auth-service для локального Docker Compose.
APP_ENV=local
APP_VERSION=dev
HTTP_ADDR=:8080
REQUEST_TIMEOUT=10s

DATABASE_URL=postgres://tripcatalog:tripcatalog_local_dev@postgres:5432/tripcatalog?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=0

JWT_SECRET=local-development-only-secret-change-before-production-2026
JWT_ISSUER=auth-service
ACCESS_TOKEN_TTL=15m
BCRYPT_COST=12

LOG_LEVEL=debug

OTEL_ENABLED=false
OTEL_SERVICE_NAME=auth-service
OTEL_TRACE_SAMPLE_RATIO=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_INSECURE=true
