{
  "uid": "inference-platform",
  "title": "Inference Platform — сервисы",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "inference-platform",
    "provisioned"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "User Service",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Доступность экземпляров",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"user-service\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{instance}}"
        }
      ],
      "description": "1 — Prometheus получил метрики; 0 — экземпляр недоступен.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP запросы / с",
      "type": "timeseries",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 9,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(app_http_requests_total{job=\"user-service\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{instance}}"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "HTTP задержка p95",
      "type": "timeseries",
      "gridPos": {
        "x": 15,
        "y": 1,
        "w": 9,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, instance) (rate(app_http_request_duration_seconds_bucket{job=\"user-service\"}[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{instance}}"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 100,
      "title": "CPU процесса, % одного ядра",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(process_cpu_seconds_total{job=\"user-service\"}[5m])",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{instance}}"
        },
        {
          "refId": "B",
          "expr": "100 * max without (job, instance) (platform_container_cpu_limit_cores{compose_service=\"user-service\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{compose_service}} · лимит"
        }
      ],
      "description": "Использование CPU процессом. 100% соответствует одному ядру. Серия «лимит» — установленный Docker предел контейнера.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 101,
      "title": "Память процесса",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 9,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"user-service\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{instance}}"
        },
        {
          "refId": "B",
          "expr": "max without (job, instance) (platform_container_memory_limit_bytes{compose_service=\"user-service\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{compose_service}} · лимит"
        }
      ],
      "description": "Резидентная память процесса; не включает память других процессов в контейнере. Серия «лимит» — установленный Docker предел контейнера.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 102,
      "title": "Goroutine",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_goroutines{job=\"user-service\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{instance}}"
        }
      ],
      "description": "Количество goroutine в процессе.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
