      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum by (instance, code) (increase(app_http_requests_total{job=\"user-service\"}[30s])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{instance}} · {{code}}"
        }
      ],
      "description": "Количество ответов за последние 30 секунд, отдельно для каждого экземпляра и кода. Prometheus оценивает прирост между опросами.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
