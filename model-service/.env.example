APP_ENV=local
APP_VERSION=dev
HTTP_ADDR=:8081
# Allow the default inference startup timeout (60s) to complete.
REQUEST_TIMEOUT=90s

# In Docker Compose, use the service name postgres as the host.
DATABASE_URL=postgres://<db_user>:<db_password>@postgres:5432/<db_name>?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=0

# Use inference-service:9091 when running in Docker Compose.
INFERENCE_GRPC_ADDR=localhost:9091

# Trusted UserService JWKS endpoint and access-token contract.
USER_JWKS_URL=http://user-service:8080/.well-known/jwks.json
JWT_ISSUER=user-service
JWT_AUDIENCE=inference-platform
JWKS_CACHE_TTL=1m
