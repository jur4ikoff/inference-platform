APP_ENV=local
LOG_LEVEL=debug
OTEL_SERVICE_NAME=inference-service
APP_VERSION=dev

# Required to create deployments. Leave empty to start without database access.
# Host example: postgres://USER:PASSWORD@localhost:5432/DATABASE?sslmode=disable
# In Docker Compose, use postgres instead of localhost.
DATABASE_URL=
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_CONNECT_TIMEOUT=5s

GRPC_ADDR=:9091
HTTP_ADDR=:8080
# Public base origin. Models use http://<project>.<deployment-name>.localhost:8082/.
PROXY_PUBLIC_URL=http://localhost:8082
REQUEST_TIMEOUT=90s
INFERENCE_SERVER_IMAGE=ghcr.io/ggml-org/llama.cpp:server
RUNTIME_PORT_HOST=18081

DEPLOYMENT_MANAGER_SYNC_INTERVAL=5s
DEPLOYMENT_MANAGER_OPERATION_TIMEOUT=5s
DEPLOYMENT_MANAGER_RECONNECT_INTERVAL=1s

DOCKER_NETWORK=
